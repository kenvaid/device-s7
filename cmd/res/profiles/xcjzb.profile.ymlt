name: ZB-XCJZB-S7-Profile
manufacturer: "兴创嘉"
description: "兴创嘉座板机XCJZB"
model: "XCJZB"
labels: 
- "座板机"

deviceResources:
  - name: VD3012
    description: "总数设定"
    isHidden: true
    properties:
      valueType: Uint32
      readWrite: R
    attributes:
      NodeName: VD3012
  - name: V9.6
    description: "有报警"
    isHidden: true
    properties:
      valueType: Bool
      readWrite: R
    attributes:
      NodeName: V9.6

deviceCommands:
  - name: "Values"
    readWrite: "R"
    isHidden: false
    resourceOperations:
      - { deviceResource: "VD3012" }

  - name: "Alarms"
    readWrite: "R"
    isHidden: false
    resourceOperations:
      - { deviceResource: "V9.6" }
